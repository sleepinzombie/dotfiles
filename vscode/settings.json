{
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // "apc.electron": {
  //   "vibrancy": "ultra-dark",
  //   "frame": true,
  //   "backgroundColor": "#2A2E3D",
  //   "transparent": true,
  //   "trafficLightPosition": {
  //     "x": 15,
  //     "y": 13
  //   }
  // },
  // "apc.stylesheet": {
  //   "*": "font-family: 'Cascadia code','Fira Code', Consolas, 'Courier New', monospace",
  //   ".editor .title": "background-color: transparent !important;",
  //   ".editor .title .actions-container": "flex-direction: row-reverse;"
  // },
  "diffEditor.experimental.showMoves": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.sortImports": "explicit"
  },
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 15,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "'Cascadia code','Fira Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": false,
  "editor.inlineSuggest.enabled": true,
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.smoothScrolling": true,
  "editor.snippetSuggestions": "bottom",
  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "emmet.includeLanguages": {
    "twig": "html"
  },
  "emmet.showSuggestionsAsSnippets": true,
  "eslint.format.enable": true,
  "explorer.compactFolders": false,
  "files.associations": {
    "*.html.twig": "twig"
  },
  "git.autofetch": true,
  "git.confirmSync": true,
  "git.enableCommitSigning": true,
  "git.mergeEditor": true,
  "html.completion.attributeDefaultValue": "doublequotes",
  "intelephense.environment.documentRoot": "core/index.php",
  "intelephense.environment.includePaths": ["web/core/includes"],
  "intelephense.files.associations": [
    "*.inc",
    "*.theme",
    "*.install",
    "*.module",
    "*.profile",
    "*.php",
    "*.phtml"
  ],
  "intelephense.format.enable": false,
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "javascript.referencesCodeLens.enabled": true,
  "javascript.referencesCodeLens.showOnAllFunctions": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "nasc-touchbar.addCursorBelow": false,
  "nasc-touchbar.copyLineDown": true,
  "nasc-touchbar.enableEditorGroup": true,
  "nasc-touchbar.goToDefinition": true,
  "nasc-touchbar.peekDefinition": true,
  "nasc-touchbar.rename": false,
  "nasc-touchbar.showCommands": false,
  "nasc-touchbar.showReferences": true,
  "nasc-touchbar.togglePanel": false,
  "php.suggest.basic": false,
  "settingsSync.ignoredSettings": [
    "-window.zoomLevel",
    "todo-tree.ripgrep.ripgrep"
  ],
  "terminal.integrated.fontFamily": "'Fira Code', MesloLGS NF",
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]"
  ],
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
  "typescript.implementationsCodeLens.enabled": true,
  "typescript.implementationsCodeLens.showOnInterfaceMethods": true,
  "typescript.referencesCodeLens.enabled": true,
  "typescript.referencesCodeLens.showOnAllFunctions": true,
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "window.commandCenter": true,
  "window.confirmBeforeClose": "keyboardOnly",
  "window.titleBarStyle": "custom",
  "workbench.colorCustomizations": {
    "[One Dark Pro Darker]": {
      "activityBar.activeBorder": "#01912c",
      "editorHoverWidget.highlightForeground": "#18A2FF",
      "list.focusBackground": "#1a722d",
      "list.hoverBackground": "#004e1e",
      "selection.background": "#1a722d",
      "titleBar.activeBackground": "#001807",
      "titleBar.activeForeground": "#d4d4d4"
    },
    "[One Dark Pro Night Flat]": {
      "activityBar.activeBorder": "#01912c",
      "editorHoverWidget.highlightForeground": "#18A2FF",
      "list.focusBackground": "#1a722d",
      "list.hoverBackground": "#004e1e",
      "selection.background": "#1a722d",
      "titleBar.activeBackground": "#001807",
      "titleBar.activeForeground": "#d4d4d4",
      "sideBar.border": "#1e22279c"
    }
  },
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.list.smoothScrolling": true,
  "workbench.productIconTheme": "material-product-icons",
  "workbench.startupEditor": "welcomePage",
  "workbench.statusBar.visible": true,
  "workbench.tree.indent": 6,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.agent.currentEditorContext.enabled": true,
  "workbench.secondarySideBar.showLabels": false,
  "workbench.panel.showLabels": false,
  "editor.hover.enabled": "on",
  "editor.hover.sticky": true,
  "editor.parameterHints.enabled": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggest.showInlineDetails": true,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": true,
    "remotes": true,
    "stashes": false,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "fileHistory": false,
    "repositories": true,
    "searchAndCompare": false,
    "launchpad": false
  },
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  // "todo-tree.ripgrep.ripgrep": "/Applications/Visual Studio Code.app/Contents/Resources/app/node_modules/@vscode/ripgrep-universal/bin/darwin-arm64/rg",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.disableLoginPrompt": true,
  "chat.viewSessions.orientation": "stacked",
  "gitlens.graph.layout": "editor"
}
